# ==============================================================================
# WhatsApp Support Gateway - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust the values as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development  # options: development, staging, production, test

# ------------------------------------------------------------------------------
# 2. WhatsApp Channel Configuration
# ------------------------------------------------------------------------------
# Provider mode: 'mock' for local simulation/offline testing, 'meta' for live Cloud API
WHATSAPP_PROVIDER=mock

# Required if WHATSAPP_PROVIDER=meta
META_APP_SECRET=dev_app_secret
META_ACCESS_TOKEN=dev_access_token
PHONE_NUMBER_ID=1000123456789
WEBHOOK_VERIFY_TOKEN=dev_verify_token

# ------------------------------------------------------------------------------
# 3. Asynchronous Message Queue
# ------------------------------------------------------------------------------
# Queue type: 'in_process' (asyncio.Queue for single instance) or 'redis' (distributed streams)
QUEUE_TYPE=in_process
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=whatsapp:events
REDIS_CONSUMER_GROUP=gateway_workers
REDIS_CONSUMER_NAME=worker-1

# ------------------------------------------------------------------------------
# 4. Order Repository & E-Commerce Backend
# ------------------------------------------------------------------------------
# Repository: 'in_memory' (built-in seed fixtures) or 'shopify' (Shopify Admin REST API)
ORDER_REPOSITORY_TYPE=in_memory
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. External Event Integrations (n8n / Make / Zapier / Helpdesk)
# ------------------------------------------------------------------------------
# Optional webhook destination for human escalation events (e.g. ticket.escalated)
# INTEGRATION_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/escalations
